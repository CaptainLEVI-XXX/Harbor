# from https://dashboard.privy.io - Apps > your app > Settings > App ID
# without this the page still renders; the Connect wallet button is simply inert.
# NOTE: this is a template. Put the real value in .env.local, which is gitignored.
NEXT_PUBLIC_PRIVY_APP_ID=
# sepolia (default - Privy sponsors gas) or hoodi (users pay gas)
NEXT_PUBLIC_CHAIN=sepolia
# hoodi only - Hoodi has no canonical WETH9, so name the one to trade
NEXT_PUBLIC_HOODI_WETH=
