# from https://dashboard.privy.io - Apps > your app > Settings > App ID
# without this the page still renders; the Connect wallet button is simply inert.
# NOTE: this is a template. Put the real value in .env.local, which is gitignored.
NEXT_PUBLIC_PRIVY_APP_ID=
# The checked-in deployment is Hoodi-only. Users pay gas.
NEXT_PUBLIC_CHAIN=hoodi
# Optional public/client-safe RPC URL. Never put private keys here.
# Blank uses the Hoodi endpoint supplied by viem's chain definition.
NEXT_PUBLIC_HOODI_RPC_URL=
# WETH and Harbor addresses are pinned together in lib/chain.ts and lib/harbor/config.ts.
# The public Studio query endpoint is accessed through /api/harbor; no deploy key is needed.
